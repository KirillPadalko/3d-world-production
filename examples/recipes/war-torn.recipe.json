{
  "schemaVersion": "1.0",
  "id": "war-torn",
  "name": "War-torn (damaged, foggy dusk)",
  "description": "Same locations after fighting: most buildings damaged or ruined, sandbag positions and wrecks as clutter, thinner vegetation, dusk with fog.",
  "seed": 42,
  "abandonment": 0.7,
  "style": { "theme": "war_torn", "weathering": 0.8 },
  "assets": {
    "requiredTags": ["stylized"],
    "preferredTags": ["weathered"],
    "excludedTags": ["modern"],
    "fallback": "placeholder"
  },
  "filters": { "minConfidence": 0.5 },
  "terrain": { "cellSizeM": 4.0, "noiseScaleM": 45, "octaves": 4 },
  "buildings": {
    "damageRatio": 0.65,
    "ruinFraction": 0.4,
    "zoneFill": { "enabled": false }
  },
  "vegetation": { "densityScale": 0.7, "minSpacingM": 3.5 },
  "infrastructure": { "streetLights": { "enabled": false } },
  "props": {
    "clutter": {
      "perBuilding": 2.5,
      "maxDistanceM": 5,
      "kindWeights": { "sandbags": 3, "car_wreck": 1, "barrel": 2, "crate": 2, "tires": 1 }
    }
  },
  "atmosphere": { "timeOfDay": "dusk", "weather": "fog", "fogDensityScale": 0.8 },
  "validation": { "failOnError": true }
}
