{
  "schemaVersion": "1.0",
  "id": "stylized-rural",
  "name": "Stylized rural (default look)",
  "description": "Clean, readable look for isometric tactical maps: infill on vacant lots, light clutter, street lights on secondary roads.",
  "seed": 1337,
  "style": { "theme": "stylized_rural", "weathering": 0.2 },
  "assets": {
    "requiredTags": ["stylized"],
    "preferredTags": ["rural"],
    "fallback": "placeholder"
  },
  "filters": { "minConfidence": 0.5 },
  "terrain": { "cellSizeM": 4.0, "noiseScaleM": 70, "octaves": 3 },
  "roads": { "sampleSpacingM": 4.0 },
  "buildings": {
    "orientToRoads": true,
    "zoneFill": {
      "enabled": true,
      "buildingWeights": { "house": 5, "shed": 1, "garage": 1 },
      "lotSpacingM": 17,
      "setbackM": 4,
      "spacingM": 3,
      "maxPerZone": 12
    }
  },
  "vegetation": { "densityScale": 1.0, "minSpacingM": 3.5, "scaleJitter": 0.18 },
  "infrastructure": {
    "poleSpacingM": 32,
    "streetLights": { "roadImportance": ["secondary"], "spacingM": 26, "placement": "alternate" }
  },
  "props": { "clutter": { "perBuilding": 1.5, "maxDistanceM": 3.5 } },
  "atmosphere": { "fogDensityScale": 1.0 },
  "validation": { "failOnError": true, "maxEntities": 20000 }
}
