# Environment Generator configuration.
# No credentials or external accounts are needed in this phase: every adapter
# that would talk to an external system is a stub (see docs/ADAPTERS.md).
# The CLI reads these variables directly; it does not load .env files itself.

# Default log level for the CLI (DEBUG, INFO, WARNING, ERROR). -v / -vv override it.
ENVGEN_LOG_LEVEL=WARNING

# Asset registry used when --registry is not given. Empty = built-in registry.
ENVGEN_ASSET_REGISTRY=

# Reserved for future adapters. NOT read by the current code.
# ENVGEN_BLENDER_EXECUTABLE=/path/to/blender
# ENVGEN_UNITY_PROJECT_PATH=/path/to/UnityProject
