{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:environment-generator:schema:location-recipe:1.0",
  "$defs": {
    "AssetSelectionSpec": {
      "additionalProperties": false,
      "properties": {
        "requiredTags": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_:-]{0,47}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Requiredtags",
          "type": "array"
        },
        "preferredTags": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_:-]{0,47}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Preferredtags",
          "type": "array"
        },
        "excludedTags": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_:-]{0,47}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Excludedtags",
          "type": "array"
        },
        "allowedArchetypes": {
          "description": "Registry archetype ID glob patterns allowed; empty = all.",
          "items": {
            "pattern": "^[a-z0-9_.*?\\[\\]-]{1,128}$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Allowedarchetypes",
          "type": "array"
        },
        "fallback": {
          "$ref": "#/$defs/FallbackPolicy",
          "default": "placeholder"
        }
      },
      "title": "AssetSelectionSpec",
      "type": "object"
    },
    "AtmosphereRecipe": {
      "additionalProperties": false,
      "description": "Lighting and weather. ``None`` keeps the blueprint's atmosphere and season.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "timeOfDay": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeOfDay"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "weather": {
          "anyOf": [
            {
              "$ref": "#/$defs/Weather"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "season": {
          "anyOf": [
            {
              "$ref": "#/$defs/Season"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fogDensityScale": {
          "default": 1.0,
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Fogdensityscale",
          "type": "number"
        },
        "windSpeedMps": {
          "anyOf": [
            {
              "maximum": 60.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Windspeedmps"
        }
      },
      "title": "AtmosphereRecipe",
      "type": "object"
    },
    "BuildingRecipe": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "orientToRoads": {
          "default": true,
          "title": "Orienttoroads",
          "type": "boolean"
        },
        "roadSearchRadiusM": {
          "default": 40.0,
          "maximum": 500.0,
          "minimum": 0.0,
          "title": "Roadsearchradiusm",
          "type": "number"
        },
        "damageRatio": {
          "default": 0.0,
          "description": "Share of intact buildings turned into damaged ones.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Damageratio",
          "type": "number"
        },
        "ruinFraction": {
          "default": 0.25,
          "description": "Share of the damaged buildings (above) that become ruins.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Ruinfraction",
          "type": "number"
        },
        "zoneFill": {
          "$ref": "#/$defs/ZoneFillRecipe"
        }
      },
      "title": "BuildingRecipe",
      "type": "object"
    },
    "BuildingType": {
      "enum": [
        "house",
        "bathhouse",
        "garage",
        "shed",
        "barn",
        "greenhouse",
        "outhouse",
        "gazebo",
        "workshop",
        "shop",
        "church",
        "apartment_block",
        "warehouse",
        "factory",
        "office",
        "other",
        "unknown"
      ],
      "title": "BuildingType",
      "type": "string"
    },
    "ClutterRecipe": {
      "additionalProperties": false,
      "description": "Small props scattered around buildings.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "perBuilding": {
          "default": 1.5,
          "maximum": 50.0,
          "minimum": 0.0,
          "title": "Perbuilding",
          "type": "number"
        },
        "maxDistanceM": {
          "default": 4.0,
          "maximum": 50.0,
          "minimum": 0.5,
          "title": "Maxdistancem",
          "type": "number"
        },
        "kindWeights": {
          "anyOf": [
            {
              "additionalProperties": {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              "propertyNames": {
                "$ref": "#/$defs/PropType"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Replaces the built-in per-building-kind prop tables when set.",
          "title": "Kindweights"
        }
      },
      "title": "ClutterRecipe",
      "type": "object"
    },
    "FallbackPolicy": {
      "description": "What to do when no archetype in the registry fits a request.",
      "enum": [
        "placeholder",
        "error"
      ],
      "title": "FallbackPolicy",
      "type": "string"
    },
    "FeatureFilter": {
      "additionalProperties": false,
      "properties": {
        "minConfidence": {
          "default": 0.0,
          "description": "Blueprint features below this confidence are ignored.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Minconfidence",
          "type": "number"
        }
      },
      "title": "FeatureFilter",
      "type": "object"
    },
    "FenceRecipe": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "gapAtRoads": {
          "default": true,
          "description": "Leave openings where a fence crosses a road.",
          "title": "Gapatroads",
          "type": "boolean"
        },
        "heightScale": {
          "default": 1.0,
          "maximum": 4.0,
          "minimum": 0.25,
          "title": "Heightscale",
          "type": "number"
        }
      },
      "title": "FenceRecipe",
      "type": "object"
    },
    "InfrastructureRecipe": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "poleSpacingM": {
          "default": 35.0,
          "maximum": 500.0,
          "minimum": 5.0,
          "title": "Polespacingm",
          "type": "number"
        },
        "streetLights": {
          "$ref": "#/$defs/StreetLightRecipe"
        }
      },
      "title": "InfrastructureRecipe",
      "type": "object"
    },
    "LayoutValidationRecipe": {
      "additionalProperties": false,
      "properties": {
        "failOnError": {
          "default": true,
          "title": "Failonerror",
          "type": "boolean"
        },
        "maxEntities": {
          "default": 50000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Maxentities",
          "type": "integer"
        },
        "minBuildingSpacingM": {
          "default": 0.5,
          "maximum": 50.0,
          "minimum": 0.0,
          "title": "Minbuildingspacingm",
          "type": "number"
        },
        "checkRoadObstruction": {
          "default": true,
          "title": "Checkroadobstruction",
          "type": "boolean"
        },
        "checkWaterObstruction": {
          "default": true,
          "title": "Checkwaterobstruction",
          "type": "boolean"
        },
        "groundToleranceM": {
          "default": 2.0,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Groundtolerancem",
          "type": "number"
        }
      },
      "title": "LayoutValidationRecipe",
      "type": "object"
    },
    "PropRecipe": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "clutter": {
          "$ref": "#/$defs/ClutterRecipe"
        }
      },
      "title": "PropRecipe",
      "type": "object"
    },
    "PropType": {
      "enum": [
        "barrel",
        "tires",
        "pallet",
        "woodpile",
        "tools",
        "bicycle",
        "wheelbarrow",
        "debris",
        "bucket",
        "bench",
        "crate",
        "gas_cylinder",
        "car",
        "car_wreck",
        "boat",
        "cart",
        "dumpster",
        "hay_bale",
        "sandbags",
        "other"
      ],
      "title": "PropType",
      "type": "string"
    },
    "RoadImportance": {
      "enum": [
        "primary",
        "secondary",
        "access",
        "track",
        "path"
      ],
      "title": "RoadImportance",
      "type": "string"
    },
    "RoadRecipe": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "widthScale": {
          "default": 1.0,
          "maximum": 4.0,
          "minimum": 0.25,
          "title": "Widthscale",
          "type": "number"
        },
        "sampleSpacingM": {
          "default": 4.0,
          "maximum": 100.0,
          "minimum": 0.5,
          "title": "Samplespacingm",
          "type": "number"
        },
        "detectJunctions": {
          "default": true,
          "title": "Detectjunctions",
          "type": "boolean"
        }
      },
      "title": "RoadRecipe",
      "type": "object"
    },
    "Season": {
      "enum": [
        "spring",
        "summer",
        "autumn",
        "winter",
        "unknown"
      ],
      "title": "Season",
      "type": "string"
    },
    "StreetLightRecipe": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "roadImportance": {
          "description": "Roads of these importance classes get street lights.",
          "items": {
            "$ref": "#/$defs/RoadImportance"
          },
          "title": "Roadimportance",
          "type": "array"
        },
        "spacingM": {
          "default": 30.0,
          "maximum": 500.0,
          "minimum": 5.0,
          "title": "Spacingm",
          "type": "number"
        },
        "offsetM": {
          "default": 0.8,
          "maximum": 20.0,
          "minimum": 0.0,
          "title": "Offsetm",
          "type": "number"
        },
        "placement": {
          "default": "alternate",
          "enum": [
            "alternate",
            "left",
            "right",
            "both"
          ],
          "title": "Placement",
          "type": "string"
        }
      },
      "title": "StreetLightRecipe",
      "type": "object"
    },
    "StyleSpec": {
      "additionalProperties": false,
      "properties": {
        "theme": {
          "default": "default",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Theme",
          "type": "string"
        },
        "weathering": {
          "default": 0.0,
          "description": "0 = pristine, 1 = heavily worn. >= 0.5 prefers archetypes tagged 'weathered'.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Weathering",
          "type": "number"
        }
      },
      "title": "StyleSpec",
      "type": "object"
    },
    "Subsystem": {
      "description": "Generation subsystems that may receive their own seed.",
      "enum": [
        "terrain",
        "roads",
        "buildings",
        "fences",
        "infrastructure",
        "vegetation",
        "props",
        "atmosphere",
        "assets"
      ],
      "title": "Subsystem",
      "type": "string"
    },
    "TerrainRecipe": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "cellSizeM": {
          "default": 4.0,
          "maximum": 50.0,
          "minimum": 0.5,
          "title": "Cellsizem",
          "type": "number"
        },
        "noiseAmplitudeM": {
          "anyOf": [
            {
              "maximum": 200.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to a value derived from the site relief.",
          "title": "Noiseamplitudem"
        },
        "noiseScaleM": {
          "default": 60.0,
          "maximum": 2000.0,
          "minimum": 1.0,
          "title": "Noisescalem",
          "type": "number"
        },
        "octaves": {
          "default": 3,
          "maximum": 8,
          "minimum": 1,
          "title": "Octaves",
          "type": "integer"
        },
        "carveWater": {
          "default": true,
          "title": "Carvewater",
          "type": "boolean"
        },
        "waterDepthM": {
          "default": 1.5,
          "maximum": 20.0,
          "minimum": 0.0,
          "title": "Waterdepthm",
          "type": "number"
        }
      },
      "title": "TerrainRecipe",
      "type": "object"
    },
    "TimeOfDay": {
      "enum": [
        "dawn",
        "morning",
        "noon",
        "afternoon",
        "dusk",
        "night"
      ],
      "title": "TimeOfDay",
      "type": "string"
    },
    "VegetationRecipe": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "densityScale": {
          "default": 1.0,
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Densityscale",
          "type": "number"
        },
        "minSpacingM": {
          "default": 3.0,
          "maximum": 50.0,
          "minimum": 0.25,
          "title": "Minspacingm",
          "type": "number"
        },
        "maxInstancesPerFeature": {
          "default": 1500,
          "maximum": 20000,
          "minimum": 0,
          "title": "Maxinstancesperfeature",
          "type": "integer"
        },
        "scaleJitter": {
          "default": 0.15,
          "maximum": 0.9,
          "minimum": 0.0,
          "title": "Scalejitter",
          "type": "number"
        },
        "understoryRatio": {
          "default": 0.2,
          "description": "Share of forest/woodland instances that become bushes.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Understoryratio",
          "type": "number"
        },
        "roadClearanceM": {
          "default": 1.0,
          "maximum": 50.0,
          "minimum": 0.0,
          "title": "Roadclearancem",
          "type": "number"
        },
        "buildingClearanceM": {
          "default": 1.5,
          "maximum": 50.0,
          "minimum": 0.0,
          "title": "Buildingclearancem",
          "type": "number"
        }
      },
      "title": "VegetationRecipe",
      "type": "object"
    },
    "Weather": {
      "enum": [
        "clear",
        "partly_cloudy",
        "overcast",
        "fog",
        "light_rain",
        "rain",
        "storm",
        "snow"
      ],
      "title": "Weather",
      "type": "string"
    },
    "ZoneFillRecipe": {
      "additionalProperties": false,
      "description": "Procedurally build on ``vacant_lot`` plots, along the roads that border them.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "buildingWeights": {
          "additionalProperties": {
            "exclusiveMinimum": 0.0,
            "type": "number"
          },
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/BuildingType"
          },
          "title": "Buildingweights",
          "type": "object"
        },
        "lotSpacingM": {
          "default": 20.0,
          "maximum": 200.0,
          "minimum": 4.0,
          "title": "Lotspacingm",
          "type": "number"
        },
        "setbackM": {
          "default": 5.0,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Setbackm",
          "type": "number"
        },
        "spacingM": {
          "default": 3.0,
          "description": "Minimum gap between infill buildings and existing objects.",
          "maximum": 50.0,
          "minimum": 0.0,
          "title": "Spacingm",
          "type": "number"
        },
        "maxPerZone": {
          "default": 40,
          "maximum": 1000,
          "minimum": 0,
          "title": "Maxperzone",
          "type": "integer"
        }
      },
      "title": "ZoneFillRecipe",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Stylisation and generation settings (public contract v1.0).",
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "appliesTo": {
      "description": "locationId glob patterns this recipe is meant for; empty = any.",
      "items": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      },
      "title": "Appliesto",
      "type": "array"
    },
    "seed": {
      "anyOf": [
        {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Master seed; null = blueprint generation.masterSeed.",
      "title": "Seed"
    },
    "subsystemSeeds": {
      "additionalProperties": {
        "maximum": 9223372036854775807,
        "minimum": 0,
        "type": "integer"
      },
      "description": "Per-subsystem seeds; they win over the blueprint's subsystemSeeds.",
      "propertyNames": {
        "$ref": "#/$defs/Subsystem"
      },
      "title": "Subsystemseeds",
      "type": "object"
    },
    "structuralSimilarity": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "null = blueprint generation.structuralSimilarity.",
      "title": "Structuralsimilarity"
    },
    "visualVariation": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "null = blueprint generation.visualVariation.",
      "title": "Visualvariation"
    },
    "detailDensity": {
      "default": 1.0,
      "description": "Multiplier for procedural detail (clutter, vegetation).",
      "maximum": 4.0,
      "minimum": 0.0,
      "title": "Detaildensity",
      "type": "number"
    },
    "abandonment": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Overall abandonment; null = blueprint atmosphere.abandonment.",
      "title": "Abandonment"
    },
    "style": {
      "$ref": "#/$defs/StyleSpec"
    },
    "assets": {
      "$ref": "#/$defs/AssetSelectionSpec"
    },
    "filters": {
      "$ref": "#/$defs/FeatureFilter"
    },
    "terrain": {
      "$ref": "#/$defs/TerrainRecipe"
    },
    "roads": {
      "$ref": "#/$defs/RoadRecipe"
    },
    "buildings": {
      "$ref": "#/$defs/BuildingRecipe"
    },
    "fences": {
      "$ref": "#/$defs/FenceRecipe"
    },
    "infrastructure": {
      "$ref": "#/$defs/InfrastructureRecipe"
    },
    "vegetation": {
      "$ref": "#/$defs/VegetationRecipe"
    },
    "props": {
      "$ref": "#/$defs/PropRecipe"
    },
    "atmosphere": {
      "$ref": "#/$defs/AtmosphereRecipe"
    },
    "validation": {
      "$ref": "#/$defs/LayoutValidationRecipe"
    },
    "metadata": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "propertyNames": {
        "maxLength": 64,
        "minLength": 1
      },
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name"
  ],
  "title": "LocationRecipe",
  "type": "object"
}
