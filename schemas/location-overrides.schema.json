{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:environment-generator:schema:location-overrides:1.0",
  "$defs": {
    "AddEntity": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "add",
          "title": "Op",
          "type": "string"
        },
        "collection": {
          "$ref": "#/$defs/EntityCollection"
        },
        "entity": {
          "additionalProperties": true,
          "description": "A complete entity of the target collection.",
          "title": "Entity",
          "type": "object"
        }
      },
      "required": [
        "op",
        "collection",
        "entity"
      ],
      "title": "AddEntity",
      "type": "object"
    },
    "ConflictPolicy": {
      "enum": [
        "fail",
        "report"
      ],
      "title": "ConflictPolicy",
      "type": "string"
    },
    "DeleteEntity": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "delete",
          "title": "Op",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "expectedType": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntityCollection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "op",
        "id"
      ],
      "title": "DeleteEntity",
      "type": "object"
    },
    "EntityCollection": {
      "description": "Blueprint collections addressable by overrides (JSON key names).",
      "enum": [
        "roadNodes",
        "roadSegments",
        "plots",
        "buildings",
        "vegetationZones",
        "trees",
        "fences",
        "infrastructure",
        "props",
        "landmarks",
        "waterBodies",
        "surfaceZones"
      ],
      "title": "EntityCollection",
      "type": "string"
    },
    "PlacementOverride": {
      "additionalProperties": false,
      "description": "Move, turn or scale a generated entity (manifest frame and IDs).",
      "properties": {
        "entityId": {
          "description": "Manifest entity ID, e.g. building.b-12.",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
          "title": "Entityid",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "maximum": 100000.0,
                  "minimum": -100000.0,
                  "type": "number"
                },
                {
                  "maximum": 9000.0,
                  "minimum": -1000.0,
                  "type": "number"
                },
                {
                  "maximum": 100000.0,
                  "minimum": -100000.0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "yawDeg": {
          "anyOf": [
            {
              "exclusiveMaximum": 360.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yawdeg"
        },
        "scale": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "exclusiveMinimum": 0.0,
                  "type": "number"
                },
                {
                  "exclusiveMinimum": 0.0,
                  "type": "number"
                },
                {
                  "exclusiveMinimum": 0.0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale"
        }
      },
      "required": [
        "entityId"
      ],
      "title": "PlacementOverride",
      "type": "object"
    },
    "ReplaceArchetype": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "replaceArchetype",
          "title": "Op",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "expectedType": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntityCollection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "archetype": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$",
          "title": "Archetype",
          "type": "string"
        }
      },
      "required": [
        "op",
        "id",
        "archetype"
      ],
      "title": "ReplaceArchetype",
      "type": "object"
    },
    "UpdateEntity": {
      "additionalProperties": false,
      "description": "RFC 7396 merge patch of one entity; ``id`` cannot change.",
      "properties": {
        "op": {
          "const": "update",
          "title": "Op",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "expectedType": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntityCollection"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fail if the entity is no longer in this collection."
        },
        "patch": {
          "additionalProperties": true,
          "minProperties": 1,
          "title": "Patch",
          "type": "object"
        }
      },
      "required": [
        "op",
        "id",
        "patch"
      ],
      "title": "UpdateEntity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Author changes for one location (public contract v1.0).",
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "locationId": {
      "description": "Overrides only apply to this location.",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Locationid",
      "type": "string"
    },
    "recipeId": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When set, overrides only apply together with this recipe.",
      "title": "Recipeid"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "author": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "conflictPolicy": {
      "$ref": "#/$defs/ConflictPolicy",
      "default": "fail"
    },
    "entityOperations": {
      "items": {
        "discriminator": {
          "mapping": {
            "add": "#/$defs/AddEntity",
            "delete": "#/$defs/DeleteEntity",
            "replaceArchetype": "#/$defs/ReplaceArchetype",
            "update": "#/$defs/UpdateEntity"
          },
          "propertyName": "op"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/UpdateEntity"
          },
          {
            "$ref": "#/$defs/ReplaceArchetype"
          },
          {
            "$ref": "#/$defs/DeleteEntity"
          },
          {
            "$ref": "#/$defs/AddEntity"
          }
        ]
      },
      "maxItems": 10000,
      "title": "Entityoperations",
      "type": "array"
    },
    "placementOverrides": {
      "items": {
        "$ref": "#/$defs/PlacementOverride"
      },
      "maxItems": 10000,
      "title": "Placementoverrides",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "propertyNames": {
        "maxLength": 64,
        "minLength": 1
      },
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "locationId"
  ],
  "title": "LocationOverrides",
  "type": "object"
}
